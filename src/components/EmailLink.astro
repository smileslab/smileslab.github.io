---
import { contact } from '../data/site'
import Icon from './Icon.astro'

interface Props {
  /** Text to show instead of the address itself. */
  label?: string
  class?: string
  showIcon?: boolean
  /** Renders as a filled button rather than an inline link. */
  variant?: 'inline' | 'button'
}

const {
  label,
  class: className,
  showIcon = false,
  variant = 'inline',
} = Astro.props

const [user, domain] = contact.email.split('@')

// The address is never emitted as a literal `mailto:` or as `user@domain`.
// It ships base64-encoded and split in two, and the script below reassembles
// it into a real link at runtime. This defeats the regex-based harvesters
// that produce most address scraping; it is not a secret, and anyone reading
// the page source can still recover it.
const encUser = Buffer.from(user).toString('base64')
const encDomain = Buffer.from(domain).toString('base64')

// Shown before the script runs, and to anyone with JavaScript disabled.
// Still readable by a person, still not a harvestable pattern.
const fallback = `${user} [at] ${domain}`
---

<span
  class:list={['email-link', className, variant]}
  data-email-user={encUser}
  data-email-domain={encDomain}
  data-email-label={label ?? ''}
>
  {showIcon && <Icon name="mail" size={variant === 'button' ? 16 : 15} />}
  <span class="email-text">{label ?? fallback}</span>
</span>

<style>
  .email-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  /* Upgraded to a real anchor by the script; style both states the same. */
  .email-link :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .email-link.inline :global(a:hover) {
    text-decoration: underline;
  }

  .email-link.button {
    justify-content: center;
    width: 100%;
    padding: 0.7rem 1.35rem;
    border-radius: var(--r-full);
    background: var(--accent);
    color: var(--accent-ink);
    font-size: var(--text-sm);
    font-weight: 600;
    box-shadow: 0 1px 2px rgb(12 23 39 / 0.1), 0 6px 16px -6px var(--accent-ring);
    transition: background-color 0.18s var(--ease);
  }

  .email-link.button:hover {
    background: var(--accent-hover);
  }
</style>

<script>
  // Reassemble each address and turn the placeholder into a real mailto link.
  for (const host of document.querySelectorAll<HTMLElement>('.email-link')) {
    const { emailUser, emailDomain, emailLabel } = host.dataset
    if (!emailUser || !emailDomain) continue

    let address: string
    try {
      address = `${atob(emailUser)}@${atob(emailDomain)}`
    } catch {
      // Malformed payload, leave the readable fallback in place.
      continue
    }

    const textNode = host.querySelector<HTMLElement>('.email-text')
    if (!textNode) continue

    const anchor = document.createElement('a')
    anchor.href = `mailto:${address}`
    anchor.textContent = emailLabel || address
    textNode.replaceWith(anchor)
  }
</script>
