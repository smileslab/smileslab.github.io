---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Slide {
  src: ImageMetadata
  alt: string
}

interface Props {
  slides: Slide[]
  /** Milliseconds each slide is held. */
  interval?: number
}

const { slides, interval = 5000 } = Astro.props
---

<div
  class="slideshow"
  data-slideshow
  data-interval={interval}
  role="group"
  aria-roledescription="slideshow"
  aria-label="Photographs of the lab and campus"
>
  <div class="frame">
    {
      slides.map((slide, index) => (
        <div
          class:list={['slide', { 'is-active': index === 0 }]}
          data-slide
          aria-hidden={index === 0 ? undefined : 'true'}
        >
          <Image
            src={slide.src}
            alt={slide.alt}
            width={1120}
            height={840}
            densities={[1, 2]}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : undefined}
          />
        </div>
      ))
    }
  </div>

  {
    slides.length > 1 && (
      <div class="dots" data-dots>
        {slides.map((_, index) => (
          <button
            type="button"
            class:list={['dot', { 'is-active': index === 0 }]}
            data-dot={index}
            aria-label={`Show photograph ${index + 1} of ${slides.length}`}
            aria-pressed={index === 0 ? 'true' : 'false'}
          />
        ))}
      </div>
    )
  }
</div>

<style>
  .slideshow {
    position: relative;
  }

  .frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    background: var(--surface-2);
  }

  /* The first slide is marked active in the HTML, and only *other* slides are
     faded out. If this script never runs, the first photograph still shows:
     nothing here can leave the frame blank. */
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s var(--ease);
  }

  .slide.is-active {
    opacity: 1;
  }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dots {
    position: absolute;
    left: 50%;
    bottom: 0.9rem;
    transform: translateX(-50%);
    display: flex;
    gap: 0.4rem;
    padding: 0.4rem 0.6rem;
    border-radius: var(--r-full);
    background: rgb(10 15 24 / 0.34);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: var(--r-full);
    background: rgb(255 255 255 / 0.5);
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease),
      width 0.3s var(--ease);
  }

  .dot:hover {
    background: rgb(255 255 255 / 0.8);
  }

  .dot.is-active {
    width: 18px;
    background: #fff;
  }

  /* Give the dots a real hit area without making them look bigger. */
  .dot::after {
    content: '';
    position: absolute;
    width: 24px;
    height: 24px;
    transform: translate(-50%, -50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-slideshow]')) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'))
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'))
    if (slides.length < 2) continue

    const interval = Number(root.dataset.interval ?? 5000)
    let current = 0
    let timer: number | undefined

    function show(next: number) {
      slides[current]?.classList.remove('is-active')
      slides[current]?.setAttribute('aria-hidden', 'true')
      dots[current]?.classList.remove('is-active')
      dots[current]?.setAttribute('aria-pressed', 'false')

      current = (next + slides.length) % slides.length

      slides[current]?.classList.add('is-active')
      slides[current]?.removeAttribute('aria-hidden')
      dots[current]?.classList.add('is-active')
      dots[current]?.setAttribute('aria-pressed', 'true')
    }

    function stop() {
      if (timer !== undefined) {
        window.clearInterval(timer)
        timer = undefined
      }
    }

    function start() {
      stop()
      // Readers who prefer reduced motion get a static first slide they can
      // still page through by hand.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
      timer = window.setInterval(() => show(current + 1), interval)
    }

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        show(index)
        start() // restart the clock so a manual pick gets a full interval
      })
    })

    // Do not cycle behind the reader's back, or in a hidden tab.
    root.addEventListener('mouseenter', stop)
    root.addEventListener('mouseleave', start)
    root.addEventListener('focusin', stop)
    root.addEventListener('focusout', start)
    document.addEventListener('visibilitychange', () =>
      document.hidden ? stop() : start()
    )

    start()
  }
</script>
