---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import SocialLinks from './SocialLinks.astro'

interface Props {
  person: CollectionEntry<'team'> | CollectionEntry<'alumni'>
  /** Renders the wider treatment used for faculty. */
  featured?: boolean
}

const { person, featured = false } = Astro.props
const data = person.data

const researchAreas =
  'researchAreas' in data ? data.researchAreas : ([] as string[])
const now = 'now' in data ? data.now : undefined
const years = 'years' in data ? data.years : undefined

// Initials stand in when a person has no photo yet.
const initials = data.name
  .replace(/^(Dr\.|Prof\.)\s+/i, '')
  .split(/\s+/)
  .slice(0, 2)
  .map((part) => part[0])
  .join('')

// The avatar renders at 112px (150px for faculty); request 2x for retina.
const renderPx = featured ? 300 : 224
---

<article class:list={['person card card-hover', { featured }]} data-reveal>
  <div class="photo">
    {
      data.photo ? (
        <Image
          src={data.photo}
          alt={`Portrait of ${data.name}`}
          width={renderPx}
          height={renderPx}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="initials" aria-hidden="true">
          {initials}
        </span>
      )
    }
  </div>

  <div class="body">
    <h3>{data.name}</h3>
    <p class="role">{data.role}</p>
    {years && <p class="years">{years}</p>}
    {
      now && (
        <p class="now">
          <span>Now</span> {now}
        </p>
      )
    }

    {
      researchAreas.length > 0 && (
        <ul class="areas">
          {researchAreas.map((area) => (
            <li class="pill">{area}</li>
          ))}
        </ul>
      )
    }

    <div class="slot"><slot /></div>

    <div class="foot">
      <SocialLinks links={data.links} personName={data.name} />
    </div>
  </div>
</article>

<style>
  .person {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.75rem 1.25rem 1rem;
  }

  /* Small circular portrait rather than a full-bleed image: at card width a
     square photo dominates the card and reads as a profile page, not a roster. */
  .photo {
    width: 112px;
    height: 112px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(
      160deg,
      var(--accent-soft),
      var(--surface-2) 70%
    );
    box-shadow: 0 0 0 1px var(--border);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 0.4s var(--ease);
  }

  .person:hover .photo :global(img) {
    transform: scale(1.06);
  }

  .initials {
    font-size: 1.75rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--accent);
    opacity: 0.6;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    margin-top: 1.1rem;
  }

  h3 {
    font-size: var(--text-base);
    font-weight: 640;
    line-height: 1.35;
  }

  .role {
    margin-top: 0.25rem;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .years {
    margin-top: 0.15rem;
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .now {
    margin-top: 0.5rem;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .now span {
    color: var(--muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-weight: 600;
  }

  .areas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
    margin-top: 0.85rem;
  }

  .areas .pill {
    font-size: 0.6875rem;
    padding: 0.15rem 0.5rem;
  }

  .slot:not(:empty) {
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.65;
    text-align: left;
  }

  .foot {
    display: flex;
    justify-content: center;
    margin-top: auto;
    padding-top: 0.9rem;
  }

  /* Faculty: portrait beside the bio, still a modest circle. */
  @media (min-width: 46rem) {
    .person.featured {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      gap: 1.75rem;
      padding: 2rem 2.25rem;
    }

    .person.featured .photo {
      width: 150px;
      height: 150px;
    }

    .person.featured .body {
      margin-top: 0;
    }

    .person.featured h3 {
      font-size: var(--text-2xl);
    }

    .person.featured .role {
      font-size: var(--text-base);
    }

    .person.featured .areas {
      justify-content: flex-start;
    }

    .person.featured .foot {
      justify-content: flex-start;
    }
  }
</style>
