---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import Icon from './Icon.astro'
import { formatDate, isoDate } from '../lib/format'

interface Props {
  post: CollectionEntry<'news'>
  /** Larger treatment for the most recent post on the news index. */
  featured?: boolean
}

const { post, featured = false } = Astro.props
const { title, date, description, kind, tags, cover, coverAlt, externalUrl } =
  post.data

const href = externalUrl ?? `/news/${post.id}`
const isExternal = Boolean(externalUrl)

// The featured treatment is a two-column split with the cover on one side.
// Without a cover there is nothing to put there, so fall back to the regular
// single-column card rather than leaving half the row empty.
const isSplit = featured && Boolean(cover)
---

<article
  class:list={['news card card-hover', { featured: isSplit, lead: featured }]}
  data-reveal
>
  {
    cover && (
      <a class="cover" href={href} tabindex="-1" aria-hidden="true">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          width={featured ? 1000 : 640}
          height={featured ? 520 : 360}
          densities={[1, 2]}
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }

  <div class="body">
    <div class="meta">
      <span class:list={['pill', kind === 'blog' ? 'pill-accent' : '']}>
        {kind === 'blog' ? 'Blog' : 'News'}
      </span>
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
    </div>

    <h3>
      <a href={href} rel={isExternal ? 'noopener noreferrer' : undefined}>
        {title}
        <span class="stretch" aria-hidden="true"></span>
      </a>
    </h3>

    <p class="excerpt">{description}</p>

    <div class="foot">
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.slice(0, 3).map((tag) => (
              <li>#{tag}</li>
            ))}
          </ul>
        )
      }
      <span class="more">
        {isExternal ? 'Read at source' : 'Read'}
        <Icon name={isExternal ? 'arrow-up-right' : 'arrow-right'} size={14} />
      </span>
    </div>
  </div>
</article>

<style>
  .news {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .cover {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
    overflow: hidden;
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .news:hover .cover :global(img) {
    transform: scale(1.03);
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.35rem 1.4rem 1.2rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.8rem;
  }

  time {
    color: var(--muted);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  h3 {
    font-size: var(--text-xl);
    line-height: 1.3;
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .excerpt {
    margin-top: 0.6rem;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.15rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .more :global(svg) {
    transition: transform 0.25s var(--ease);
  }

  .news:hover .more :global(svg) {
    transform: translateX(3px);
  }

  /* Coverless lead post: no split, just a touch more presence. */
  .news.lead:not(.featured) .body {
    padding: 1.75rem 1.85rem 1.6rem;
  }

  .news.lead:not(.featured) h3 {
    font-size: var(--text-2xl);
  }

  .news.lead:not(.featured) .excerpt {
    font-size: var(--text-base);
    max-width: 62ch;
  }

  @media (min-width: 46rem) {
    .news.featured {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: stretch;
    }

    .news.featured .cover {
      aspect-ratio: auto;
      height: 100%;
    }

    .news.featured .body {
      padding: 2rem 2.15rem;
      justify-content: center;
    }

    .news.featured h3 {
      font-size: var(--text-2xl);
    }

    .news.featured .excerpt {
      font-size: var(--text-base);
    }
  }
</style>
