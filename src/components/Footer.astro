---
import { footerNav, site } from '../data/site'
import Icon from './Icon.astro'

const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a href="/" class="brand" aria-label={`${site.name} home`}>
          <span class="mark" aria-hidden="true">
            <svg viewBox="0 0 256 256" width="30" height="30" fill="none">
          <path
            fill="currentColor"
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M128 24C102 43 74 57 43 64C35 66 30 73 30 81V120C30 172 63 211 128 233C193 211 226 172 226 120V81C226 73 221 66 213 64C182 57 154 43 128 24ZM128 47C105 62 80 74 53 81V120C53 159 77 190 128 210C179 190 203 159 203 120V81C176 74 151 62 128 47ZM128 69A18 18 0 1 1 127.999 105A18 18 0 0 1 128 69ZM121 98H135V124H121ZM128 118A19 19 0 1 1 127.999 156A19 19 0 0 1 128 118ZM113 140L123 151L91 179L81 168ZM143 140L175 168L165 179L133 151ZM78 158A18 18 0 1 1 77.999 194A18 18 0 0 1 78 158ZM178 158A18 18 0 1 1 177.999 194A18 18 0 0 1 178 158Z"></path>
        </svg>
          </span>
          <span class="wordmark"><strong>SMILES</strong> <span>Lab</span></span>
        </a>
        <p class="blurb">
          {site.longName}. Multimodal, neuro-symbolic AI for multimedia
          forensics, cybersecurity and clinical decision support at the {
            site.institution
          }.
        </p>
      </div>

      <div class="links">
        {
          footerNav.map((column) => (
            <div>
              <h2>{column.title}</h2>
              <ul>
                {column.items.map((item) => (
                  <li>
                    <a href={item.href}>
                      {item.label}
                      {item.href.startsWith('http') && (
                        <Icon name="arrow-up-right" size={13} />
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="bottom">
      <p>© {year} {site.name}, {site.institution}. All rights reserved.</p>
      <p class="colophon">
        Built with <a href="https://astro.build" rel="noopener">Astro</a>.
        <a href="https://github.com/smileslab/smileslab.github.io" rel="noopener"
          >Source</a
        >
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
    background: var(--bg-tint);
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
  }

  .top {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
  }

  .mark {
    display: grid;
    place-items: center;
    color: var(--accent);
  }

  .wordmark {
    line-height: 1;
    font-size: 1.0625rem;
  }

  .wordmark strong {
    font-weight: 700;
  }

  .wordmark span {
    color: var(--muted);
    font-weight: 500;
  }

  .blurb {
    margin-top: 1rem;
    max-width: 44ch;
    color: var(--ink-2);
    line-height: 1.65;
  }

  .mail {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.15rem;
    font-weight: 550;
    text-decoration: none;
  }

  .mail:hover {
    text-decoration: underline;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 2rem 1.5rem;
  }

  .links h2 {
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }

  .links ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--ink-2);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--accent);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .colophon a {
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
  }

  .colophon a:hover {
    color: var(--accent);
  }

  @media (min-width: 52rem) {
    .top {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.5fr);
      gap: 4rem;
    }
  }
</style>
