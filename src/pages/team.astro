---
import { getCollection, render } from 'astro:content'
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import PersonCard from '../components/PersonCard.astro'
import Icon from '../components/Icon.astro'

const everyone = await getCollection('team')

const groups = [
  { key: 'faculty', title: 'Faculty', blurb: 'Principal investigator' },
  {
    key: 'postdoc',
    title: 'Research fellows',
    blurb: 'Postdoctoral and senior researchers',
  },
  { key: 'phd', title: 'PhD students', blurb: null },
  { key: 'ms', title: "Master's students", blurb: null },
  { key: 'undergrad', title: 'Undergraduate researchers', blurb: null },
  { key: 'collaborator', title: 'Collaborators', blurb: null },
] as const

const sections = await Promise.all(
  groups.map(async (group) => {
    const members = everyone
      .filter((person) => person.data.group === group.key)
      .sort(
        (a, b) =>
          a.data.order - b.data.order || a.data.name.localeCompare(b.data.name)
      )

    // Faculty bios render inline, so their Markdown body needs rendering.
    const rendered = await Promise.all(
      members.map(async (person) => ({
        person,
        Content:
          group.key === 'faculty' ? (await render(person)).Content : null,
      }))
    )

    return { ...group, members: rendered }
  })
)

const populated = sections.filter((section) => section.members.length > 0)
---

<Base
  title="Team"
  description="The people of the SMILES Lab: faculty, research fellows, and graduate students working on multimodal neuro-symbolic AI at the University of Michigan–Flint."
>
  <PageHeader
    eyebrow="People"
    title="The team"
    lede="A small group of researchers working across multimedia forensics, cybersecurity and clinical AI — and the students who do most of the hard work."
  />

  <div class="section">
    <div class="wrap groups">
      {
        populated.map((section) => (
          <section class="group" aria-labelledby={`group-${section.key}`}>
            <header class="group-head">
              <h2 id={`group-${section.key}`}>{section.title}</h2>
              <span class="count">
                {section.members.length}
                <span class="sr-only"> members</span>
              </span>
            </header>

            <div
              class:list={[
                'grid',
                section.key === 'faculty' ? 'grid-faculty' : 'grid-people',
              ]}
            >
              {section.members.map(({ person, Content }) => (
                <PersonCard
                  person={person}
                  featured={section.key === 'faculty'}
                >
                  {Content && <Content />}
                </PersonCard>
              ))}
            </div>
          </section>
        ))
      }

      <aside class="alumni-note card" data-reveal>
        <div>
          <h2>Lab alumni</h2>
          <p>
            Former students and fellows, and where their work took them next.
          </p>
        </div>
        <a href="/alumni" class="btn btn-secondary btn-sm">
          View alumni
          <Icon name="arrow-right" size={15} />
        </a>
      </aside>
    </div>
  </div>
</Base>

<style>
  .groups {
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem);
  }

  .group-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border);
  }

  .group-head h2 {
    font-size: var(--text-2xl);
  }

  .count {
    display: inline-grid;
    place-items: center;
    min-width: 1.6rem;
    height: 1.6rem;
    padding-inline: 0.4rem;
    border-radius: var(--r-full);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .grid-faculty {
    grid-template-columns: minmax(0, 1fr);
    max-width: 62rem;
  }

  .alumni-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.6rem 1.75rem;
    background: var(--bg-tint);
  }

  .alumni-note h2 {
    font-size: var(--text-xl);
  }

  .alumni-note p {
    margin-top: 0.35rem;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
</style>
