---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import PageHeader from '../../components/PageHeader.astro'
import NewsCard from '../../components/NewsCard.astro'
import Icon from '../../components/Icon.astro'

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)

const [latest, ...rest] = posts

const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort()
---

<Base
  title="News & blog"
  description="Awards, publications, collaborations and longer technical writing from the SMILES Lab at the University of Michigan–Flint."
>
  <PageHeader
    eyebrow="News"
    title="News &amp; writing"
    lede="Awards, accepted papers, new collaborations, and the occasional longer post about what we are building."
  >
    <a class="feed" href="/rss.xml">
      Subscribe via RSS
      <Icon name="arrow-up-right" size={14} />
    </a>
  </PageHeader>

  <div class="section">
    <div class="wrap">
      {
        posts.length === 0 ? (
          <div class="empty card">
            <h2>Nothing published yet</h2>
            <p>
              Posts live in <code>src/content/news/</code>. Copy{' '}
              <code>_template.md</code>, fill it in, and set{' '}
              <code>draft: false</code>.
            </p>
          </div>
        ) : (
          <>
            {tags.length > 1 && (
              <div class="tag-bar" data-tag-bar>
                <button
                  type="button"
                  class="tag is-active"
                  data-tag=""
                  aria-pressed="true"
                >
                  All
                </button>
                {tags.map((tag) => (
                  <button
                    type="button"
                    class="tag"
                    data-tag={tag}
                    aria-pressed="false"
                  >
                    #{tag}
                  </button>
                ))}
              </div>
            )}

            <div class="feed-list" data-news-list>
              {latest && (
                <div
                  class="row featured-row"
                  data-post
                  data-tags={latest.data.tags.join(' ')}
                >
                  <NewsCard post={latest} featured />
                </div>
              )}

              {rest.length > 0 && (
                <div class="grid grid-cards">
                  {rest.map((post) => (
                    <div data-post data-tags={post.data.tags.join(' ')}>
                      <NewsCard post={post} />
                    </div>
                  ))}
                </div>
              )}
            </div>

            <p class="no-results" data-news-empty hidden>
              No posts with that tag yet.
            </p>
          </>
        )
      }
    </div>
  </div>
</Base>

<style>
  .feed {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .feed:hover {
    text-decoration: underline;
  }

  .tag-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tag {
    padding: 0.42rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    background: var(--surface);
    color: var(--ink-2);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.18s var(--ease),
      border-color 0.18s var(--ease),
      color 0.18s var(--ease);
  }

  .tag:hover {
    border-color: var(--border-strong);
    color: var(--ink);
  }

  .tag.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .feed-list {
    display: grid;
    gap: 1.5rem;
  }

  .row[hidden],
  [data-post][hidden] {
    display: none;
  }

  .empty {
    padding: 3rem;
    text-align: center;
    background: var(--bg-tint);
  }

  .empty p {
    margin-top: 0.75rem;
    color: var(--ink-2);
  }

  .no-results {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--muted);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.1em 0.35em;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-tag-bar]')
  const posts = Array.from(
    document.querySelectorAll<HTMLElement>('[data-post]')
  )
  const empty = document.querySelector<HTMLElement>('[data-news-empty]')

  if (bar && posts.length) {
    const buttons = Array.from(
      bar.querySelectorAll<HTMLButtonElement>('[data-tag]')
    )

    bar.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-tag]'
      )
      if (!button) return

      const wanted = button.dataset.tag ?? ''
      let visible = 0

      for (const other of buttons) {
        const active = other === button
        other.classList.toggle('is-active', active)
        other.setAttribute('aria-pressed', String(active))
      }

      for (const post of posts) {
        const tags = (post.dataset.tags ?? '').split(/\s+/).filter(Boolean)
        const show = !wanted || tags.includes(wanted)
        post.hidden = !show
        if (show) visible += 1
      }

      if (empty) empty.hidden = visible !== 0
    })
  }
</script>
