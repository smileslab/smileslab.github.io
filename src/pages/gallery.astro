---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import Icon from '../components/Icon.astro'
import cvpr1 from '../assets/lab/cvpr_1.jpg'
import cvpr2 from '../assets/lab/cvpr_2.jpg'
import cvpr3 from '../assets/lab/cvpr_3.jpg'
import interspeech2 from '../assets/lab/interspeech_2.jpg'
import interspeech3 from '../assets/lab/interspeech_3.jpg'
import interspeech4 from '../assets/lab/interspeech_4.jpg'
import interspeech5 from '../assets/lab/interspeech_5.jpg'
import interspeech6 from '../assets/lab/interspeech_6.jpg'

// Every fifth photo (index 0, 5, ...) gets a wide tile, so keep landscape
// shots in those slots.
const photos = [
  {
    src: cvpr1,
    alt: 'SMILES Lab members posing in front of the CVPR sign at CVPR 2026 in Denver',
    caption: 'The lab at CVPR 2026, Denver',
  },
  {
    src: cvpr2,
    alt: 'Lab members beside the CVPR 2026 sponsor board in the Denver convention centre',
    caption: 'Arriving at CVPR 2026',
  },
  {
    src: cvpr3,
    alt: 'Two lab members standing in front of the CVPR sign',
    caption: 'At the CVPR sign, Denver',
  },
  {
    src: interspeech4,
    alt: 'A speaker at the podium of the International Convention Centre Sydney during Interspeech 2026',
    caption: 'Speaking at Interspeech 2026, Sydney',
  },
  {
    src: interspeech3,
    alt: 'The Interspeech 2026 banner over a view of Sydney Harbour at night',
    caption: 'Interspeech 2026 at ICC Sydney',
  },
  {
    src: interspeech6,
    alt: 'The main Interspeech 2026 stage set for a panel on AI in communication sciences',
    caption: 'The Interspeech 2026 main stage',
  },
  {
    src: interspeech5,
    alt: 'Attendees in the Interspeech 2026 exhibition hall',
    caption: 'Between sessions at Interspeech 2026',
  },
  {
    src: interspeech2,
    alt: 'A 2026 sign with a line drawing of the Sydney skyline',
    caption: 'Interspeech 2026 stage detail',
  },
]
---

<Base
  title="Gallery"
  description="Photographs from SMILES Lab events, talks and everyday research life at the University of Michigan-Flint."
>
  <PageHeader
    title="Life in the lab"
    lede="Talks, milestones and the occasional group photo."
  />

  <div class="section">
    <div class="wrap">
      <ul class="gallery">
        {
          photos.map((photo, index) => (
            <li
              class:list={['shot', { wide: index % 5 === 0 }]}
              data-reveal
              data-reveal-delay={(index % 3) * 70}
            >
              <button
                type="button"
                data-lightbox
                data-index={index}
                aria-label={`View larger: ${photo.caption}`}
              >
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  width={index % 5 === 0 ? 1200 : 700}
                  height={index % 5 === 0 ? 700 : 520}
                  densities={[1, 2]}
                  loading={index < 2 ? 'eager' : 'lazy'}
                />
                <span class="zoom" aria-hidden="true">
                  <Icon name="search" size={16} />
                </span>
              </button>
              <figcaption>{photo.caption}</figcaption>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <dialog class="lightbox" data-lightbox-dialog aria-label="Photo viewer">
    <button
      type="button"
      class="close"
      data-lightbox-close
      aria-label="Close photo viewer"
    >
      <Icon name="close" size={20} />
    </button>
    <img data-lightbox-image src="" alt="" />
  </dialog>
</Base>

<style>
  .gallery {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: 1rem;
  }

  .shot button {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--r);
    overflow: hidden;
    background: var(--surface-2);
    cursor: zoom-in;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .shot button:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .shot button:hover :global(img) {
    transform: scale(1.04);
  }

  .zoom {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: var(--r-full);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(6px);
    color: var(--ink);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .shot button:hover .zoom,
  .shot button:focus-visible .zoom {
    opacity: 1;
    transform: none;
  }

  figcaption {
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 60rem) {
    .shot.wide {
      grid-column: span 2;
    }

    .shot.wide :global(img) {
      aspect-ratio: 16 / 9;
    }
  }

  /* --- lightbox --- */
  .lightbox {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: min(92vw, 1200px);
    max-height: 92vh;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgb(6 10 18 / 0.82);
    backdrop-filter: blur(4px);
  }

  .lightbox img {
    width: 100%;
    height: auto;
    max-height: 92vh;
    object-fit: contain;
    border-radius: var(--r);
    box-shadow: var(--shadow-lg);
  }

  .close {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: var(--r-full);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    box-shadow: var(--shadow);
  }

  .close:hover {
    background: var(--surface-2);
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(
    '[data-lightbox-dialog]'
  )
  const target = document.querySelector<HTMLImageElement>(
    '[data-lightbox-image]'
  )
  const closeButton = document.querySelector<HTMLButtonElement>(
    '[data-lightbox-close]'
  )

  // Without <dialog> support the buttons simply do nothing and the grid still
  // works, so there is no need for a fallback path.
  if (dialog && target && typeof dialog.showModal === 'function') {
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach(
      (button) => {
        button.addEventListener('click', () => {
          const image = button.querySelector('img')
          if (!image) return
          target.src = image.currentSrc || image.src
          target.alt = image.alt
          dialog.showModal()
        })
      }
    )

    closeButton?.addEventListener('click', () => dialog.close())

    // Clicking the backdrop (i.e. the dialog itself, outside the image).
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })

    dialog.addEventListener('close', () => {
      target.src = ''
    })
  }
</script>
