---
import type { GetStaticPaths } from 'astro'
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection('projects')
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content } = await render(project)
const { title, summary, area, icon, funder, amount, status, links } =
  project.data

const others = (await getCollection('projects'))
  .filter((entry) => entry.id !== project.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3)
---

<Base title={title} description={summary} type="article">
  <article>
    <header class="project-header">
      <div class="wrap">
        <a href="/research" class="back">
          <Icon name="arrow-right" size={15} class="flip" />
          All projects
        </a>

        <div class="head-row">
          <span class="glyph" aria-hidden="true"><Icon name={icon} size={26} /></span>
          <div class="labels">
            <span class="area">{area}</span>
            <span class:list={['pill', status === 'active' ? 'pill-accent' : '']}>
              {status === 'active' ? 'Active' : 'Completed'}
            </span>
          </div>
        </div>

        <h1>{title}</h1>
        <p class="lede">{summary}</p>

        {
          (funder || amount || links.length > 0) && (
            <div class="facts">
              {funder && (
                <div class="fact">
                  <span class="fact-label">Funded by</span>
                  <span class="fact-value">{funder}</span>
                </div>
              )}
              {amount && (
                <div class="fact">
                  <span class="fact-label">Award</span>
                  <span class="fact-value strong">{amount}</span>
                </div>
              )}
              {links.length > 0 && (
                <div class="fact">
                  <span class="fact-label">Links</span>
                  <span class="fact-links">
                    {links.map((link) => (
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {link.label}
                        <Icon name="arrow-up-right" size={13} />
                      </a>
                    ))}
                  </span>
                </div>
              )}
            </div>
          )
        }
      </div>
    </header>

    <div class="section">
      <div class="wrap">
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="section section-tint">
        <div class="wrap">
          <h2 class="eyebrow">More research</h2>
          <ul class="others">
            {others.map((other) => (
              <li>
                <a href={`/research/${other.id}`}>
                  <span class="other-area">{other.data.area}</span>
                  <span class="other-title">{other.data.title}</span>
                  <Icon name="arrow-right" size={16} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  .project-header {
    padding-block: clamp(2rem, 5vw, 3.25rem) clamp(1.5rem, 3vw, 2.25rem);
    background:
      radial-gradient(
        55rem 22rem at 15% -20%,
        var(--accent-soft) 0%,
        transparent 65%
      ),
      var(--bg);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 550;
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
  }

  .back :global(.flip) {
    transform: rotate(180deg);
  }

  .head-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }

  .glyph {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex: none;
    border-radius: var(--r-sm);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    color: var(--accent);
  }

  .labels {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .area {
    font-size: var(--text-xs);
    font-weight: 620;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    font-size: var(--text-4xl);
    margin-top: 1.25rem;
    max-width: 22ch;
  }

  .lede {
    margin-top: 1.15rem;
  }

  .facts {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }

  .fact {
    display: grid;
    gap: 0.3rem;
  }

  .fact-label {
    font-size: var(--text-xs);
    font-weight: 620;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .fact-value {
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .fact-value.strong {
    color: var(--ink);
    font-weight: 640;
  }

  .fact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .fact-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-sm);
    font-weight: 550;
    text-decoration: none;
  }

  .fact-links a:hover {
    text-decoration: underline;
  }

  .others {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }

  .others a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.25rem 1rem;
    padding: 1.1rem 1.35rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      border-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .others a:hover {
    border-color: var(--border-strong);
    transform: translateX(3px);
  }

  .other-area {
    grid-column: 1;
    font-size: var(--text-xs);
    font-weight: 620;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .other-title {
    grid-column: 1;
    color: var(--ink);
    font-weight: 580;
    line-height: 1.4;
  }

  .others :global(svg) {
    grid-column: 2;
    grid-row: 1 / -1;
    color: var(--accent);
  }

  @media (min-width: 46rem) {
    .facts {
      grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
      gap: 2rem;
    }
  }
</style>
