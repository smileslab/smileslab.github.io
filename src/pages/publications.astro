---
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import Icon from '../components/Icon.astro'
import {
  publications,
  publicationCount,
  venues,
  years,
} from '../lib/publications'

// Only offer the venue filter for venues with more than one paper; the long
// tail is reachable through search.
const filterableVenues = venues.filter((venue) => venue.count > 1)
---

<Base
  title="Publications"
  description={`${publicationCount} peer-reviewed publications from the SMILES Lab across multimedia forensics, deepfake detection, neuro-symbolic AI and clinical decision support.`}
>
  <PageHeader
    eyebrow="Publications"
    title="Peer-reviewed work"
    lede={`${publicationCount} papers in journals and conferences spanning multimedia forensics, deepfake detection, neuro-symbolic reasoning and clinical AI.`}
  />

  <div class="section">
    <div class="wrap">
      <div class="toolbar" data-pub-toolbar>
        <div class="search">
          <Icon name="search" size={18} />
          <label class="sr-only" for="pub-search">Search publications</label>
          <input
            type="search"
            id="pub-search"
            data-pub-search
            placeholder="Search by title, author or venue…"
            autocomplete="off"
          />
        </div>

        <div class="filters">
          {
            filterableVenues.length > 0 && (
              <div class="select">
                <label class="sr-only" for="pub-venue">
                  Filter by venue
                </label>
                <select id="pub-venue" data-pub-venue>
                  <option value="">All venues</option>
                  {filterableVenues.map((venue) => (
                    <option value={venue.name}>
                      {venue.name} ({venue.count})
                    </option>
                  ))}
                </select>
              </div>
            )
          }

          {
            years.length > 1 && (
              <div class="select">
                <label class="sr-only" for="pub-year">
                  Filter by year
                </label>
                <select id="pub-year" data-pub-year>
                  <option value="">All years</option>
                  {years.map((year) => (
                    <option value={String(year)}>{year}</option>
                  ))}
                </select>
              </div>
            )
          }

          <button type="button" class="btn btn-ghost btn-sm" data-pub-reset hidden>
            Clear
          </button>
        </div>
      </div>

      <p class="result-count" data-pub-count aria-live="polite">
        Showing all {publicationCount} publications
      </p>

      <ol class="pub-list" data-pub-list>
        {
          publications.map((publication, index) => (
            <li
              class="pub"
              data-pub
              data-search={publication.search}
              data-venue={publication.venue}
              data-year={publication.year ?? ''}
            >
              <span class="index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>

              <div class="pub-body">
                <h2>
                  {publication.link ? (
                    <a
                      href={publication.link}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {publication.title}
                    </a>
                  ) : (
                    publication.title
                  )}
                </h2>

                {publication.authors && (
                  <p class="authors">{publication.authors}</p>
                )}

                <div class="pub-meta">
                  {publication.venue && (
                    <span class="venue">{publication.venue}</span>
                  )}
                  {publication.year && (
                    <span class="pill">{publication.year}</span>
                  )}
                  {publication.impactFactor && (
                    <span class="pill" title="Journal impact factor">
                      IF {publication.impactFactor}
                    </span>
                  )}
                </div>
              </div>

              {publication.link && (
                <a
                  class="read"
                  href={publication.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Read "${publication.title}"`}
                >
                  Read
                  <Icon name="arrow-up-right" size={14} />
                </a>
              )}
            </li>
          ))
        }
      </ol>

      <p class="no-results" data-pub-empty hidden>
        No publications match that search. <button
          type="button"
          class="linkish"
          data-pub-reset>Clear the filters</button
        > to see all {publicationCount}.
      </p>
    </div>
  </div>
</Base>

<style>
  .toolbar {
    display: grid;
    gap: 0.75rem;
    position: sticky;
    top: 4.5rem;
    z-index: 20;
    padding-block: 0.85rem;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    margin-bottom: 0.5rem;
  }

  @supports not (backdrop-filter: blur(1px)) {
    .toolbar {
      background: var(--bg);
    }
  }

  .search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.15rem 0.95rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    box-shadow: var(--shadow-sm);
    transition:
      border-color 0.18s var(--ease),
      box-shadow 0.18s var(--ease);
  }

  .search:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-ring);
  }

  .search :global(svg) {
    color: var(--muted);
    flex: none;
  }

  .search input {
    flex: 1;
    min-width: 0;
    padding: 0.65rem 0;
    border: 0;
    background: none;
    outline: none;
    font-size: var(--text-sm);
  }

  .search input::-webkit-search-cancel-button {
    cursor: pointer;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .select {
    position: relative;
  }

  select {
    appearance: none;
    padding: 0.55rem 2.1rem 0.55rem 0.95rem;
    max-width: 16rem;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    background: var(--surface);
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: 550;
    cursor: pointer;
    text-overflow: ellipsis;
    box-shadow: var(--shadow-sm);
  }

  select:hover {
    border-color: var(--border-strong);
  }

  /* Chevron drawn with a border so it inherits the theme automatically. */
  .select::after {
    content: '';
    position: absolute;
    right: 1rem;
    top: 50%;
    width: 0.42rem;
    height: 0.42rem;
    border-right: 1.7px solid var(--muted);
    border-bottom: 1.7px solid var(--muted);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .result-count {
    color: var(--muted);
    font-size: var(--text-sm);
    margin-bottom: 1.5rem;
  }

  .pub-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
    counter-reset: pub;
  }

  .pub {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.35rem 1rem;
    padding: 1.35rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .pub:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .pub[hidden] {
    display: none;
  }

  .index {
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
  }

  .pub h2 {
    font-size: var(--text-lg);
    font-weight: 620;
    line-height: 1.4;
  }

  .pub h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .pub h2 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .authors {
    margin-top: 0.4rem;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .pub-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .venue {
    color: var(--muted);
    font-size: var(--text-sm);
    font-style: italic;
  }

  .read {
    display: none;
    align-items: center;
    gap: 0.3rem;
    align-self: start;
    padding: 0.4rem 0.8rem;
    border-radius: var(--r-full);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 620;
    text-decoration: none;
    white-space: nowrap;
  }

  .read:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .no-results {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--ink-2);
  }

  .linkish {
    border: 0;
    background: none;
    padding: 0;
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }

  @media (min-width: 40rem) {
    .toolbar {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }

  @media (min-width: 52rem) {
    .pub {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: start;
      gap: 0.35rem 1.35rem;
    }

    .read {
      display: inline-flex;
    }
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>('[data-pub-list]')
  const search = document.querySelector<HTMLInputElement>('[data-pub-search]')
  const venue = document.querySelector<HTMLSelectElement>('[data-pub-venue]')
  const year = document.querySelector<HTMLSelectElement>('[data-pub-year]')
  const count = document.querySelector<HTMLElement>('[data-pub-count]')
  const empty = document.querySelector<HTMLElement>('[data-pub-empty]')
  const resetButtons = document.querySelectorAll<HTMLButtonElement>(
    '[data-pub-reset]'
  )

  if (list && count) {
    const items = Array.from(list.querySelectorAll<HTMLElement>('[data-pub]'))
    const total = items.length

    function apply() {
      const term = (search?.value ?? '').trim().toLowerCase()
      const wantVenue = venue?.value ?? ''
      const wantYear = year?.value ?? ''
      let visible = 0

      for (const item of items) {
        const matchesTerm =
          !term || (item.dataset.search ?? '').includes(term)
        const matchesVenue = !wantVenue || item.dataset.venue === wantVenue
        const matchesYear = !wantYear || item.dataset.year === wantYear
        const show = matchesTerm && matchesVenue && matchesYear

        item.hidden = !show
        if (show) visible += 1
      }

      const filtering = Boolean(term || wantVenue || wantYear)
      count!.textContent = filtering
        ? `Showing ${visible} of ${total} publications`
        : `Showing all ${total} publications`

      if (empty) empty.hidden = visible !== 0
      resetButtons.forEach((button) => {
        if (button.classList.contains('btn')) button.hidden = !filtering
      })
    }

    function reset() {
      if (search) search.value = ''
      if (venue) venue.value = ''
      if (year) year.value = ''
      apply()
      search?.focus()
    }

    search?.addEventListener('input', apply)
    venue?.addEventListener('change', apply)
    year?.addEventListener('change', apply)
    resetButtons.forEach((button) => button.addEventListener('click', reset))

    apply()
  }
</script>
