---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import PersonCard from '../components/PersonCard.astro'
import Icon from '../components/Icon.astro'

const alumni = (await getCollection('alumni')).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.name.localeCompare(b.data.name)
)
---

<Base
  title="Alumni"
  description="Former members of the SMILES Lab at the University of Michigan–Flint, and where their research took them next."
>
  <PageHeader
    eyebrow="People"
    title="Alumni"
    lede="Researchers who have moved on from the lab. Their work is still part of ours."
  />

  <div class="section">
    <div class="wrap">
      {
        alumni.length > 0 ? (
          <div class="grid grid-people">
            {alumni.map((person) => (
              <PersonCard person={person} />
            ))}
          </div>
        ) : (
          <div class="empty card">
            <span class="glyph" aria-hidden="true">
              <Icon name="sparkle" size={26} />
            </span>
            <h2>No alumni listed yet</h2>
            <p>
              This page fills itself in from{' '}
              <code>src/content/alumni/</code>. Copy{' '}
              <code>_template.md</code> in that folder, rename it to the
              person's name, and they will appear here on the next build.
            </p>
            <a href="/team" class="btn btn-secondary btn-sm">
              Meet the current team
              <Icon name="arrow-right" size={15} />
            </a>
          </div>
        )
      }
    </div>
  </div>
</Base>

<style>
  .empty {
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(2.25rem, 5vw, 3.5rem);
    text-align: center;
    background: var(--bg-tint);
  }

  .glyph {
    display: inline-grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: var(--r-full);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .empty h2 {
    font-size: var(--text-2xl);
  }

  .empty p {
    margin: 0.85rem auto 1.6rem;
    max-width: 46ch;
    color: var(--ink-2);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.1em 0.35em;
  }
</style>
