---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import ProjectCard from '../components/ProjectCard.astro'
import NewsCard from '../components/NewsCard.astro'
import { site, stats } from '../data/site'
import { publicationCount } from '../lib/publications'
import heroImage from '../assets/lab/lab-1.jpeg'

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)

const posts = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const team = await getCollection('team')

const liveStats = stats.map((stat) =>
  stat.label.includes('publications')
    ? { value: `${publicationCount}`, label: stat.label }
    : stat.label.includes('researchers')
      ? { value: `${team.length}`, label: stat.label }
      : stat
)

const areas = [
  {
    icon: 'shield' as const,
    title: 'Multimedia forensics',
    body: 'Detecting deepfaked audio, video and images, and explaining how the system reached its verdict.',
  },
  {
    icon: 'brain' as const,
    title: 'Clinical decision support',
    body: 'Predicting and managing stroke risk from imaging and clinical text, with federated, explainable models.',
  },
  {
    icon: 'graph' as const,
    title: 'Neuro-symbolic AI',
    body: 'Combining learned representations with symbolic knowledge so machines can explain their reasoning.',
  },
]
---

<Base>
  {/* The hero deliberately carries no data-reveal: above-the-fold content
      paints immediately, and animating the LCP image delays it. */}
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1>
          Making AI systems<br /><span class="grad">you can trust.</span>
        </h1>
        <p class="lede">
          The SMILES Lab builds multimodal, neuro-symbolic AI for multimedia
          forensics, cybersecurity and clinical decision support. Our systems
          are designed so their conclusions can be examined.
        </p>
        <div class="hero-actions">
          <a href="/research" class="btn btn-primary">
            Explore our research
            <Icon name="arrow-right" size={16} />
          </a>
          <a href="/join" class="btn btn-secondary">Join the lab</a>
        </div>
      </div>

      <div class="hero-media">
        <Image
          src={heroImage}
          alt="Members of the SMILES Lab at a lab event"
          width={1120}
          height={840}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="stats-band">
    <div class="wrap">
      <dl class="stats">
        {
          liveStats.map((stat) => (
            <div data-reveal>
              <dt>{stat.value}</dt>
              <dd>{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <h2 class="section-title">Three questions drive the lab</h2>
        <p class="lede">
          Our work combines machine learning with symbolic reasoning, applied
          to problems where being wrong has a real cost.
        </p>
      </header>

      <ul class="areas grid grid-cards">
        {
          areas.map((area, index) => (
            <li
              class="area card card-hover"
              data-reveal
              data-reveal-delay={index * 80}
            >
              <span class="area-icon" aria-hidden="true">
                <Icon name={area.icon} size={24} />
              </span>
              <h3>{area.title}</h3>
              <p>{area.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <header class="section-head with-action" data-reveal>
        <div>
          <h2 class="section-title">Research in progress</h2>
        </div>
        <a href="/research" class="btn btn-secondary btn-sm">
          All projects
          <Icon name="arrow-right" size={15} />
        </a>
      </header>

      <div class="grid grid-cards">
        {projects.map((project) => <ProjectCard project={project} compact />)}
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <div class="wrap">
          <header class="section-head with-action" data-reveal>
            <div>
              <h2 class="section-title">News &amp; writing</h2>
            </div>
            <a href="/news" class="btn btn-secondary btn-sm">
              All news
              <Icon name="arrow-right" size={15} />
            </a>
          </header>

          <div class="grid grid-cards">
            {posts.map((post) => (
              <NewsCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="cta-band">
    <div class="wrap">
      <div class="cta card" data-reveal>
        <div>
          <h2>Thinking about a PhD with us?</h2>
          <p>
            We take a small number of students each year to work on multimodal
            neuro-symbolic AI in cybersecurity and stroke informatics. Here is
            what we look for, and how to apply.
          </p>
        </div>
        <a href="/join" class="btn btn-primary">
          Read the guidance
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- hero --- */
  .hero {
    position: relative;
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3rem, 7vw, 5.5rem);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -30% -10% auto -10%;
    height: 80%;
    background: radial-gradient(
      50% 50% at 30% 40%,
      var(--accent-soft) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: -1;
  }

  .hero-inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  h1 {
    font-size: var(--text-display);
    letter-spacing: -0.033em;
    font-weight: 700;
  }

  .grad {
    background: linear-gradient(
      100deg,
      var(--accent) 0%,
      color-mix(in srgb, var(--accent) 55%, var(--ink)) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-copy .lede {
    margin-top: 1.5rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-media {
    position: relative;
  }

  .hero-media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border);
  }

  /* --- stats --- */
  .stats-band {
    padding-block: clamp(2rem, 4vw, 2.75rem);
    background: var(--bg-tint);
    border-block: 1px solid var(--border);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1rem;
    margin: 0;
  }

  .stats div {
    text-align: center;
  }

  .stats dt {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .stats dd {
    margin: 0.35rem 0 0;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  /* --- sections --- */
  .section-head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* The label above these headings used to supply the visual break; without
     it the lede needs its own breathing room. */
  .section-head .lede {
    margin-top: 0.75rem;
  }

  .section-head.with-action {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .areas {
    list-style: none;
    padding: 0;
  }

  .area {
    padding: 1.75rem 1.6rem;
  }

  .area-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--r-sm);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    color: var(--accent);
    margin-bottom: 1.15rem;
  }

  .area h3 {
    font-size: var(--text-xl);
  }

  .area p {
    margin-top: 0.6rem;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  /* --- closing CTA --- */
  .cta-band {
    padding-block: 0 clamp(4rem, 8vw, 6rem);
  }

  .cta {
    display: grid;
    gap: 1.75rem;
    padding: clamp(2rem, 4vw, 3rem);
    background:
      radial-gradient(
        40rem 20rem at 85% 120%,
        var(--accent-soft) 0%,
        transparent 70%
      ),
      var(--surface);
    align-items: center;
  }

  .cta h2 {
    font-size: var(--text-2xl);
  }

  .cta p {
    margin-top: 0.75rem;
    color: var(--ink-2);
    max-width: 58ch;
  }

  .cta .btn {
    justify-self: start;
  }

  @media (min-width: 40rem) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }

    .cta {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2.5rem;
    }

    .cta .btn {
      justify-self: end;
    }
  }
</style>
